NET "io1<9>"       LOC = "P85" | IOSTANDARD = LVCMOS33 | SLEW = FAST | BUFG = CLK;
NET "io1<10>"      LOC = "P87" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
NET "io1<11>"      LOC = "P88" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
