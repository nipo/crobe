# FTDI Synchronous FIFO (Port A)
NET "fifo_data<0>" LOC = "P70" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
NET "fifo_data<1>" LOC = "P69" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
NET "fifo_data<2>" LOC = "P67" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
NET "fifo_data<3>" LOC = "P66" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
NET "fifo_data<4>" LOC = "P65" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
NET "fifo_data<5>" LOC = "P64" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
NET "fifo_data<6>" LOC = "P62" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
NET "fifo_data<7>" LOC = "P61" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
NET "fifo_rxfn"    LOC = "P60" | IOSTANDARD = LVCMOS33 | SLEW = FAST;              # Data ready in RX buffer (act low)
NET "fifo_txen"    LOC = "P59" | IOSTANDARD = LVCMOS33 | SLEW = FAST;              # Room available in TX buffer (act low)
NET "fifo_rdn"     LOC = "P58" | IOSTANDARD = LVCMOS33 | SLEW = FAST;              # Read data from FTDI (oen must be low 1 cycle before, act low)
NET "fifo_wrn"     LOC = "P57" | IOSTANDARD = LVCMOS33 | SLEW = FAST;              # Put date to FTDI (oen must be high one cycle before, act low)
NET "fifo_clk"     LOC = "P56" | IOSTANDARD = LVCMOS33 | SLEW = FAST | BUFG = CLK | PERIOD = 16.66 ns;
NET "fifo_oen"     LOC = "P51" | IOSTANDARD = LVCMOS33 | SLEW = FAST;              # when low, fifo_data[] is ftdi -> fpga

# 12MHz oscillator input
NET "clk"          LOC =  "P55" | IOSTANDARD = LVCMOS33 | SLEW = FAST | BUFG = CLK | PERIOD = 83.33 ns;

# JTAG from FTDI (MPSSE Port B)
NET "jtag_en"      LOC =  "P35" | IOSTANDARD = LVCMOS25 | SLEW = SLOW;     # Route JTAG to FPGA IO pins rather than dedicated programming pins
NET "jtag_tdi"     LOC =  "P40" | IOSTANDARD = LVCMOS33 | SLEW = SLOW;     # Always connected to FTDI
NET "jtag_tms"     LOC =  "P38" | IOSTANDARD = LVCMOS33 | SLEW = SLOW;     # Always connected to FTDI
NET "jtag_tdo"     LOC =  "P39" | IOSTANDARD = LVCMOS33 | SLEW = SLOW;     # Routed to FTDI when jtag_en is high
NET "jtag_tck"     LOC =  "P33" | IOSTANDARD = LVCMOS33 | SLEW = SLOW;     # Routed from FTDI when jtag_en is high

# User IF
NET "user_led"     LOC =  "P34" | IOSTANDARD = LVCMOS25 | SLEW = SLOW;     # Active low, hardware debounce
NET "user_btn"     LOC =  "P127" | IOSTANDARD = LVCMOS25 | SLEW = SLOW;    # Active high

# IOs
NET "io_en"        LOC =  "P32" | IOSTANDARD = LVCMOS25 | SLEW = SLOW;     # Enable buffers, if any, active high

NET "io0<0>"       LOC =  "P50" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
NET "io0<1>"       LOC =  "P48" | IOSTANDARD = LVCMOS33 | SLEW = FAST;     # RST
NET "io0<2>"       LOC =  "P47" | IOSTANDARD = LVCMOS33 | SLEW = FAST;     # TDO   SWO
NET "io0<3>"       LOC =  "P46" | IOSTANDARD = LVCMOS33 | SLEW = FAST;     # RTCK
NET "io0<4>"       LOC =  "P45" | IOSTANDARD = LVCMOS33 | SLEW = FAST;     # TCK   SWCLK
NET "io0<5>"       LOC =  "P44" | IOSTANDARD = LVCMOS33 | SLEW = FAST;     # TMS   SWDIO
NET "io0<6>"       LOC =  "P43" | IOSTANDARD = LVCMOS33 | SLEW = FAST;     # TDI
NET "io0<7>"       LOC =  "P41" | IOSTANDARD = LVCMOS33 | SLEW = FAST;     # TRST

NET "io1<0>"       LOC = "P74" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
NET "io1<1>"       LOC = "P75" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
NET "io1<2>"       LOC = "P78" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
NET "io1<3>"       LOC = "P79" | IOSTANDARD = LVCMOS33 | SLEW = FAST;
