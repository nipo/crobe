! Initialize


HDR	0;
HIR	0;
TDR	0;
TIR	0;
ENDDR	DRPAUSE;
ENDIR	IRPAUSE;
! FREQUENCY	1.00e+006 HZ;
STATE	IDLE;

! Enter MFG Mode
SIR 8
    TDI (90);

! Shift in ISC ENABLE(0xC6) instruction
SIR	8	TDI  (C6);
SDR	8	TDI  (08);
RUNTEST	IDLE	1.00 SEC;

! Shift in ISC ERASE(0x0E) instruction
SIR	8	TDI  (0E);
SDR	8	TDI  (01);! Shift in ISC ERASE(0x0E) instruction
SIR	8	TDI  (0E);
SDR	8	TDI  (01);

! Shift in ISC ENABLE(0xC6) instruction
SIR	8	TDI  (C6);
SDR	8	TDI  (08);
RUNTEST	IDLE	1.00 SEC;

! PRIVATE Erase Password protect
SIR 8
	TDI (BC);
SDR 128
	TDI (00000000000000000000000000000000);
RUNTEST	IDLE	1.00 SEC;

! Erase Feature row
SIR 8
	TDI (0E);
SDR 8
	TDI (02);
RUNTEST	IDLE	20.50E-000 SEC;

! Shift in LSC_CHECK_BUSY(0xF0) instruction
SIR	8	TDI  (F0);
SDR	1	TDI  (0)
		TDO  (0);



! Check the IDCODE Again
!       Checking 32 bit device ID;
SIR 8
	TDI (16);
SDR 32 
	TDI (00000000)
	TDO (012B0043)
	MASK(0FFF0FFF);



	

