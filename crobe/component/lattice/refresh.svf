

! Lattice Semiconductor Corp.
! Serial Vector Format (.SVF) File.
! User information:
! File name: refresh.svf
! CREATED BY:    Diamond Deployment Tool 3.9
! CREATION DATE: Fri Jan 10 15:01:29 2020
! Device: LCMXO2-1200HC  XFLASH TransFR front_panel.bit
! LATTICE_NOTE "Device" "LCMXO2-1200HC"
! SVF Revision D Format
! SVF Revision C Format
! TCK Frequency = 1MHz



! Initialize

! Row_Width	  :1080
! Address_Length :333
HDR	0;
HIR	0;
TDR	0;
TIR	0;
ENDDR	DRPAUSE;
ENDIR	IRPAUSE;
STATE	IDLE;


! Check the IDCODE

! Shift in IDCODE_PUB(0xE0) instruction
SIR	8	TDI  (E0);
SDR	32	TDI  (00000000)
		TDO  (012BA043)
		MASK (FFFFFFFF);


! Refresh

! Shift in LSC_REFRESH(0x79) instruction
SIR	8	TDI  (79);
! wait 1.00e+00 SEC
RUNTEST	IDLE	1000002 TCK;
! Shift in BYPASS(0xFF) instruction
SIR	8	TDI  (FF);
! wait 5.00e+00 SEC
RUNTEST	IDLE	5000100 TCK;
